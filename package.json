{
  "name": "@asl-19/string-scripts",
  "version": "1.0.0",
  "type": "module",
  "description": "CLI utilities for converting between CSV and JSON formats for string translations and syncing multiple translation files",
  "contributors": [
    {
      "name": "Grant Heaslip",
      "email": "grant@asl19.org",
      "url": "https://asl19.org/"
    },
    {
      "name": "Min Van",
      "email": "min@asl19.org",
      "url": "https://asl19.org/"
    }
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASL-19/string-scripts.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "sideEffects": false,
  "bin": {
    "convertStringsCsvToJson": "./dist/bin/convertStringsCsvToJson.js",
    "convertStringsJsonToCsv": "./dist/bin/convertStringsJsonToCsv.js",
    "syncAndSortStrings": "./dist/bin/syncAndSortStrings.js"
  },
  "scripts": {
    "build": "npm run rm-dist && npm run tsc",
    "build-lint-test": "npm-run-all -l -p tsc -s lint-test",
    "dev": "npm-run-all -l -p tsc-watch",
    "eslint-check": "eslint .",
    "eslint-fix": "eslint . --fix",
    "lint-test": "run-p -l eslint-check prettier-check tsc-check vitest",
    "npm-check-updates": "npm-check-updates",
    "prepublishOnly": "run-s rm-dist build-lint-test",
    "prettier-check": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "rm-dist": "rm -rf dist/*",
    "tsc": "tsc --project tsconfig-dist.json",
    "tsc-check": "tsc --noEmit",
    "tsc-watch": "tsc --project tsconfig-dist.json --watch",
    "vitest": "vitest run",
    "vitest-watch": "vitest"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "lodash": "^4.17.21",
    "yargs": "^18.0.0"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@asl-19/eslint-config": "^0.9.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.16.4",
    "@types/yargs": "^17.0.33",
    "eslint": "^9.31.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "npm-check-updates": "^18.0.1",
    "npm-run-all2": "^8.0.4",
    "package-changed": "^3.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
