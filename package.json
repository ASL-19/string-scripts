{
  "name": "@asl-19/string-scripts",
  "version": "1.0.0",
  "type": "module",
  "description": "CLI utilities for converting between CSV and JSON formats for string translations and syncing multiple translation files",
  "contributors": [
    {
      "name": "Grant Heaslip",
      "email": "grant@asl19.org",
      "url": "https://asl19.org/"
    },
    {
      "name": "Min Van",
      "email": "min@asl19.org",
      "url": "https://asl19.org/"
    }
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASL-19/string-scripts.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "sideEffects": false,
  "bin": {
    "convertStringsCsvToJson": "./dist/bin/convertStringsCsvToJson.js",
    "convertStringsJsonToCsv": "./dist/bin/convertStringsJsonToCsv.js",
    "syncAndSortStrings": "./dist/bin/syncAndSortStrings.js"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "attw-check": "attw --pack . --profile esm-only",
    "build": "rm -rf dist && tsc --project tsconfig-dist.json",
    "build-lint-test": "run-s build lint-test",
    "dev-lint-test": "npm install --no-audit && npm run lint-test",
    "eslint-check": "eslint .",
    "eslint-fix": "eslint . --fix",
    "lint-test": "run-p -l tsc-check eslint-check prettier-check vitest-check publint-check attw-check",
    "mise-outdated": "mise outdated --local",
    "npm-outdated": "npm outdated || true",
    "outdated": "run-s -c -l mise-outdated npm-outdated pinact-outdated",
    "pinact-outdated": "pinact run --update --check --min-age 7 || true",
    "pinact-update": "pinact run --update --min-age 7",
    "prepublishOnly": "npm run build-lint-test",
    "prettier-check": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "publint-check": "publint",
    "test": "vitest",
    "tsc-check": "tsc --noEmit && tsc --noEmit --project tsconfig-dist.json",
    "vitest-check": "vitest run"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "lodash": "^4.18.1",
    "yargs": "^18.2.0"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "allowScripts": {
    "fsevents": false
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@asl-19/eslint-config": "^1.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24.19.2",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.12.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
